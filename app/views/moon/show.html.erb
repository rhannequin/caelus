<% content_for :title, "#{t("title")} • #{t(".title")}" %>
<% content_for :description, t(".meta_description") %>

<%= render "hero", moon: @moon %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="space-y-6">
    <%= render "today", moon: @moon %>

    <%= render "coordinates", moon: @moon %>

    <%= render(
      "distances",
      moon: @moon,
      next_perigee: @next_perigee,
      next_apogee: @next_apogee
    ) %>
  </div>

  <div class="space-y-6">
    <%= cache(
      "moon_upcoming_phases/#{observer_daily_cache_key}",
      expires_at: observer_end_of_day
    ) do %>
      <%= render "upcoming_phases", upcoming_phases: @upcoming_phases %>
    <% end %>
    <%= cache(
      "moon_this_week/#{observer_daily_cache_key}",
      expires_at: observer_end_of_day
    ) do %>
      <%= render "this_week", week: @week %>
    <% end %>
  </div>

  <div class="space-y-6">
    <%= render "physical_characteristics", moon: @moon %>
    <%= render "lunar_calendars", time: @time %>
  </div>
</div>
