<% content_for :title, "#{t("title")} • #{t(".title")}" %>

<%= render(
  "hero",
  sun: @sun,
  yesterday_sun: @yesterday_sun,
  transit_altitude: @transit_altitude
) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="space-y-6">
    <%= render "today", sun: @sun %>

    <%= render "twilight", twilight_event: @twilight_event %>

    <%= render(
      "coordinates",
      sun: @sun,
      longitude: @observer.longitude,
      time: @time
    ) %>

    <%= render(
      "photography",
      golden_blue_hour_calculator: @golden_blue_hour_calculator
    ) %>
  </div>

  <div class="space-y-6">
    <%= render(
      "distances",
      sun: @sun,
      next_perihelion: @next_perihelion,
      next_aphelion: @next_aphelion
    ) %>

    <%= render "seasons", upcoming_seasons: @upcoming_seasons %>

    <%= render(
      "sky_position",
      sun: @sun,
      zodiac_sign: @zodiac_sign,
      sub_solar_observer: @sub_solar_observer
    ) %>
  </div>

  <div class="space-y-6">
    <%= render "practical_info", sun: @sun %>

    <%= cache("sun_elevation_chart/#{observer_yearly_cache_key}", expires_at: observer_end_of_year) do %>
      <%= render(
        "elevation_chart",
        yearly_elevation: @yearly_elevation,
        time: @time
      ) %>
    <% end %>

    <%= render "calendar", time: @time %>
  </div>
</div>
