<% content_for :title, "#{t("title")} • #{t(".title")}" %>

<%= form_with(url: lunar_eclipses_path, method: :get) do |f| %>
  <%= f.label :year, t(".form.year") %>
  <%= f.number_field :year, value: @selected_year %>
  <%= f.submit t(".form.submit") %>
<% end %>

<h2><%= t(".list.title", year: @selected_year) %></h2>

<ul>
  <% @lunar_eclipses.each do |eclipse| %>
    <li>
      <%= link_to lunar_eclipse_path(id: l(eclipse.instant.to_time.utc.to_date)) do %>
        <%= l eclipse.instant.to_time.utc.to_date, format: :long %>
      <% end %>
      (<%= eclipse.kind %>)
    </li>
  <% end %>
</ul>
