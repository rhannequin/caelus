<% content_for :heading, t(".title") %>
<% content_for :title, t(".meta_title") %>
<% content_for :description, t(".meta_description") %>

<%= cache(
  "sky_map/#{observer_cache_key}/#{custom_time? ? @time.to_i : "now"}",
  expires_in: 5.minutes
) do %>
  <div class="rounded-lg border bg-card text-card-foreground shadow-sm
    cosmic-card">
    <h2 class="text-xl font-bold mb-1 text-cosmic">
      <%= t ".overhead_title" %>
    </h2>
    <p class="text-sm text-muted-foreground mb-4">
      <%= t ".subtitle" %>
    </p>
    <%= render SkyMapComponent.new(sky_map: @sky_map) %>
  </div>
<% end %>
