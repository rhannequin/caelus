<div class="lg:col-span-4 space-y-6">
  <%= cache(
    "tonight_sky/#{observer_daily_cache_key}",
    expires_at: observer_end_of_day
  ) do %>
    <%= render(
      "tonight_sky",
      observer: @observer,
      twilight_events: @twilight_events,
      next_twilight_events: @next_twilight_events,
      planets: @planets
    ) %>
  <% end %>
  <%= cache("current_moon/#{observer_daily_cache_key}", expires_in: 1.hour) do %>
    <%= render "current_moon", moon: @moon %>
  <% end %>
  <%= cache(
    "sun_moon_times/#{observer_daily_cache_key}",
    expires_at: observer_end_of_day
  ) do %>
    <%= render(
      "sun_moon_times",
      twilight_events: @twilight_events,
      sun: @sun,
      moon: @moon
    ) %>
  <% end %>
</div>

<div class="lg:col-span-5 space-y-6">
  <%= cache(
    "planets_tonight/#{observer_daily_cache_key}",
    expires_at: observer_end_of_day
  ) do %>
    <%= render "planets_tonight", planets: @planets %>
  <% end %>
</div>

<%= cache(
  "deep_sky_objects_tonight/#{observer_daily_cache_key}",
  expires_at: observer_end_of_day
) do %>
  <%= render(
    "deep_sky_objects",
    messier_object_positions: @messier_object_positions
  ) %>
<% end %>
