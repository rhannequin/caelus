<div class="rounded-lg border bg-card text-card-foreground shadow-sm
  cosmic-card">
  <h2 class="text-xl font-bold mb-3 text-primary">
    <%= t ".title" %>
  </h2>

  <p class="text-sm text-muted-foreground">
    <%= t(conjunction.moon? ? ".moon_planet" : ".planetary") %>
  </p>

