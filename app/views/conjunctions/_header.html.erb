<div>
  <span class="almanac-badge
    almanac-badge--<%= conjunction.celestial_event.kind.dasherize %>">
    <%= celestial_event_kind_name(conjunction.celestial_event) %>
  </span>

  <h2 class="text-2xl font-bold text-cosmic mt-3"><%= title %></h2>

  <p class="text-sm text-muted-foreground mt-1">
    <%= t(
      ".summary",
      date: date,
      time: l(conjunction.peak_at, format: :hm),
      utc: l(conjunction.peak_at.utc, format: :utc_hm),
      separation: conjunction_separation(conjunction.separation)
    ) %>
  </p>
</div>
